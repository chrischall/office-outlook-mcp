# All optional. With nothing set, the server captures a token from your
# signed-in Outlook browser tab via the fetchproxy bridge.

# Pre-obtained Outlook bearer token. Overrides the bridge.
# Power users / CI only — expires in ~25h and cannot be auto-refreshed.
# OUTLOOK_ACCESS_TOKEN=

# Disable browser capture entirely (requires OUTLOOK_ACCESS_TOKEN).
# OUTLOOK_DISABLE_FETCHPROXY=1

# Override the REST base URL.
# OUTLOOK_API_BASE=https://outlook.office.com/api/v2.0

# fetchproxy concentrator port. 37149 is the fleet-wide shared port the
# Transporter extension dials — do not pick a "unique" one.
# OUTLOOK_WS_PORT=37149

# Seconds to wait for the Outlook tab to make a request we can read.
# OUTLOOK_CAPTURE_TIMEOUT=30

# Token cache between runs.
# OUTLOOK_TOKEN_CACHE=true
# OUTLOOK_TOKEN_FILE=~/.office-outlook-mcp/token.json
